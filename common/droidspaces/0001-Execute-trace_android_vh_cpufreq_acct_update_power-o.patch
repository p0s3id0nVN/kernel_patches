From 7b0c9ed988e2905005bc302e088e7189244672a7 Mon Sep 17 00:00:00 2001
From: fatalcoder524 <11532648+fatalcoder524@users.noreply.github.com>
Date: Fri, 24 Apr 2026 01:48:43 +0530
Subject: [PATCH] Execute trace_android_vh_cpufreq_acct_update_power only if
 task->comm is valid

---
 cpufreq_times.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/drivers/cpufreq/cpufreq_times.c b/drivers/cpufreq/cpufreq_times.c
index aeb7b7b..3ce55d4 100644
--- a/drivers/cpufreq/cpufreq_times.c
+++ b/drivers/cpufreq/cpufreq_times.c
@@ -136,6 +136,7 @@ void cpufreq_acct_update_power(struct task_struct *p, u64 cputime)
 	unsigned long flags;
 	unsigned int state;
 	struct cpu_freqs *freqs = all_freqs[task_cpu(p)];
+	char comm[TASK_COMM_LEN] = {0};
 
 	if (!freqs || is_idle_task(p) || p->flags & PF_EXITING)
 		return;
@@ -148,7 +149,9 @@ void cpufreq_acct_update_power(struct task_struct *p, u64 cputime)
 		p->time_in_state[state] += cputime;
 	spin_unlock_irqrestore(&task_time_in_state_lock, flags);
 
-	trace_android_vh_cpufreq_acct_update_power(cputime, p, state);
+	get_task_comm(comm, p);
+	if (comm[0] != '\0')
+		trace_android_vh_cpufreq_acct_update_power(cputime, p, state);
 }
 
 static int cpufreq_times_get_index(struct cpu_freqs *freqs, unsigned int freq)
-- 
2.52.0.windows.1

